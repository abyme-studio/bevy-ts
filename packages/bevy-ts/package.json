{
  "name": "bevy-ts",
  "version": "0.1.0-alpha.0",
  "description": "TypeScript for Bevy: components, systems and hot reload without recompiling Rust",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abyme-studio/bevy-ts.git",
    "directory": "packages/bevy-ts"
  },
  "type": "module",
  "bin": {
    "bevy-ts": "bin/bevy-ts.js"
  },
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./runtime/core.js"
    },
    "./bevy": {
      "types": "./bevy.d.ts",
      "default": "./runtime/bevy.js"
    },
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts",
      "default": "./runtime/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./jsx-dev-runtime.d.ts",
      "default": "./runtime/jsx-dev-runtime.js"
    },
    "./material": {
      "types": "./material.d.ts",
      "default": "./runtime/material.js"
    },
    "./protocol": {
      "types": "./protocol.d.ts"
    },
    "./globals": {
      "types": "./globals.d.ts"
    },
    "./testing": {
      "types": "./testing.d.ts",
      "default": "./testing.js"
    },
    "./vite": {
      "types": "./plugins/vite.d.ts",
      "default": "./plugins/vite.js"
    },
    "./esbuild": {
      "types": "./plugins/esbuild.d.ts",
      "default": "./plugins/esbuild.js"
    }
  },
  "files": [
    "*.d.ts",
    "*.js",
    "bin",
    "runtime",
    "plugins",
    "examples"
  ],
  "optionalDependencies": {
    "@bevy-ts/darwin-arm64": "0.1.0-alpha.0",
    "@bevy-ts/darwin-x64": "0.1.0-alpha.0",
    "@bevy-ts/linux-arm64": "0.1.0-alpha.0",
    "@bevy-ts/linux-x64": "0.1.0-alpha.0",
    "@bevy-ts/win32-x64": "0.1.0-alpha.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "check": "node scripts/sync-runtime.mjs --check && tsc -p ../../examples/cube && tsc -p ../../examples/ui-gallery && tsc -p ../../examples/arena && tsc -p test && tsc -p test/types-node",
    "prepack": "node scripts/sync-examples.mjs",
    "test": "node scripts/sync-examples.mjs && vitest run --config test/vitest/vitest.config.mjs"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
