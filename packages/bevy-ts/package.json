{
  "name": "bevy-ts",
  "version": "0.1.0",
  "description": "TypeScript for Bevy: components, systems and hot reload without recompiling Rust",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rjmathieson/bevy-ts"
  },
  "type": "module",
  "bin": {
    "bevy-ts": "bin/bevy-ts.js"
  },
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./bevy": {
      "types": "./bevy.d.ts"
    },
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts"
    },
    "./jsx-dev-runtime": {
      "types": "./jsx-dev-runtime.d.ts"
    },
    "./protocol": {
      "types": "./protocol.d.ts"
    }
  },
  "files": [
    "*.d.ts",
    "bin"
  ],
  "optionalDependencies": {
    "@bevy-ts/darwin-arm64": "0.1.0",
    "@bevy-ts/darwin-x64": "0.1.0",
    "@bevy-ts/linux-x64": "0.1.0",
    "@bevy-ts/linux-arm64": "0.1.0",
    "@bevy-ts/win32-x64": "0.1.0"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "check": "tsc -p ../../examples/cube && tsc -p test"
  }
}
