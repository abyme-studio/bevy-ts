// The arena: two enemies and two copies of the room.
/* Placement only; what an enemy is lives in enemy.tsx. */

#EnemyA
@game::Enemy
Transform { translation: Vec3 { x: -3.0, z: -4.0 } }
--
#EnemyB
@game::Enemy { @hp: 250.0, team: 1 }
Transform { translation: Vec3 { x: 3.0, z: -4.0 } }
Children [
    // Override the prefab's eye by name (E3).
    #eye
    Transform { translation: Vec3 { y: 0.8 } }
]
--
#RoomA
:"room.bsn"
--
#RoomB
:"./room.bsn"
Transform { translation: Vec3 { x: 20.0 } } // shifted
